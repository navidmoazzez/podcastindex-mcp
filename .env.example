# From https://api.podcastindex.org/signup - both halves are needed.
# The secret is what signs each request; the key alone cannot authenticate.
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# Optional. Podcast Index asks every client to identify itself.
# PODCASTINDEX_USER_AGENT=my-app/1.0

# Optional safety controls.
# PODCASTINDEX_READ_ONLY=1
# PODCASTINDEX_AUDIT_LOG=~/.podcastindex-mcp/writes.jsonl
